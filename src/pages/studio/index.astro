---
// Content Studio — storyboard mode. Idea → 3 anchored scenes (Claude) →
// identity-locked stills → ONE approval gate → 3 motion clips → final cut.
// Same design language as Savoy Admin (night, gold, Fraunces).
import { listReels } from '../../lib/studio/db';
import { GIRAFFE_POSES } from '../../lib/studio/config';

const authUser = Astro.locals.user;
if (!authUser) return Astro.redirect('/sign-in?next=/studio');

const recent = await listReels(authUser.id);

function timeAgo(d: Date | string): string {
  const diff = Date.now() - new Date(d).getTime();
  const m = Math.floor(diff / 60000), h = Math.floor(diff / 3600000), day = Math.floor(diff / 86400000);
  if (m < 1) return 'acum';
  if (h < 1) return `acum ${m} min`;
  if (day < 1) return `acum ${h}h`;
  return `acum ${day} zile`;
}
const STATUS_LABEL: Record<string, string> = {
  draft: 'Ciornă', storyboard_ready: 'Storyboard',
  image_generating: 'Imagini…', image_ready: 'Așteaptă aprobare', image_failed: 'Eroare imagine',
  approved: 'Aprobat', audio_generating: 'Voce…', video_generating: 'Video…',
  video_failed: 'Eroare video', complete: 'Gata',
};
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Content Studio · Savoy</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="st-top">
    <a href="/savoy/admin" class="st-back">← Savoy Admin</a>
    <span class="st-logo">CONTENT<span>·</span>STUDIO</span>
    <span class="st-top-spacer"></span>
  </nav>

  <main class="st-main">
    <header class="st-head" id="head-intro">
      <p class="st-kicker">Domnul Girafă lucrează pentru tine</p>
      <h1>De la idee la <em>reel,</em> în patru pași.</h1>
    </header>

    <!-- Progress -->
    <div class="st-steps" id="steps" hidden>
      <div class="st-step" data-step="story"><i></i>Storyboard</div>
      <div class="st-step" data-step="image"><i></i>Imagini</div>
      <div class="st-step" data-step="approve"><i></i>Aprobare</div>
      <div class="st-step" data-step="video"><i></i>Film</div>
    </div>

    <!-- STEP 0: Brief -->
    <section class="st-card" id="card-brief">
      <div class="st-modes">
        <button class="st-mode active" data-mode="scene" type="button">
          <span class="st-mode-ic">🏖️</span><strong>Scenă de hotel</strong>
          <span>Atmosferă Savoy, fără girafă. 3 cadre în mișcare, 24s.</span>
        </button>
        <button class="st-mode" data-mode="giraffe" type="button">
          <span class="st-mode-ic">🦒</span><strong>Girafa vorbește</strong>
          <span>Domnul Girafă joacă în 3 scene și spune replica ta.</span>
        </button>
      </div>
      <label class="st-label" for="title">Nume reel</label>
      <input id="title" class="st-input" type="text" maxlength="80" placeholder="ex: Weekend la piscină" />
      <label class="st-label" for="scene">Ideea</label>
      <textarea id="scene" class="st-input" rows="3" placeholder="ex: Girafa își petrece ziua la piscina hotelului, de dimineața până la apus"></textarea>
      <div id="dialogue-row" hidden>
        <label class="st-label" for="dialogue">Ce spune Domnul Girafă <span class="st-hint">(~40-80 de cuvinte = 15-30s)</span></label>
        <textarea id="dialogue" class="st-input" rows="3" maxlength="400" placeholder="ex: Salutare! Azi vă arăt cum arată o zi perfectă la Savoy. Spoiler: implică două înghețate."></textarea>
      </div>
      <button class="st-btn st-btn-gold" id="btn-create" type="button">Generează storyboard-ul →</button>
      <p class="st-error" id="brief-error" hidden></p>
    </section>

    <!-- STEP 1: Storyboard -->
    <section id="card-story" hidden>
      <div class="st-row-head">
        <h2>Storyboard <span class="st-mono">3 scene × 8s</span></h2>
        <button class="st-btn st-btn-ghost st-btn-sm" id="btn-restory" type="button">↻ Alt storyboard</button>
      </div>
      <div class="st-scenes" id="story-grid"></div>
      <button class="st-btn st-btn-gold" id="btn-images" type="button">Generează cele 3 imagini →</button>
      <p class="st-error" id="story-error" hidden></p>
    </section>

    <!-- STEP 2/3: Images + approval -->
    <section id="card-images" hidden>
      <div class="st-row-head">
        <h2>Cadrele ancoră <span class="st-mono">identitate locked</span></h2>
      </div>
      <div class="st-scenes" id="image-grid"></div>
      <div class="st-gate" id="gate" hidden>
        <p>Verifică girafa în fiecare cadru: pălărie, papion, pete, proporții. Videoul costă bani și pornește doar după OK-ul tău.</p>
        <button class="st-btn st-btn-gold" id="btn-approve" type="button">Aprobă tot → generează filmul</button>
      </div>
      <p class="st-error" id="image-error" hidden></p>
    </section>

    <!-- STEP 4: Rendering + final -->
    <section id="card-final" hidden>
      <div class="st-render" id="render-progress" hidden>
        <div class="st-spin"></div>
        <p id="render-label">Animăm scenele…</p>
        <div class="st-render-dots" id="render-dots"></div>
      </div>
      <div class="st-done" id="done" hidden>
        <video id="final-video" controls playsinline></video>
        <div class="st-row">
          <a class="st-btn st-btn-gold" id="btn-download" download>Descarcă reel-ul</a>
          <a class="st-btn st-btn-ghost" href="/savoy/admin">Programează postarea →</a>
          <button class="st-btn st-btn-ghost" id="btn-new" type="button">Reel nou</button>
        </div>
      </div>
      <div id="fail" hidden>
        <p class="st-error" id="fail-msg"></p>
        <button class="st-btn st-btn-ghost" id="btn-retry" type="button">Încearcă din nou</button>
      </div>
    </section>

    {recent.length > 0 && (
      <section class="st-history" id="history">
        <span class="st-mono st-history-label">Reels recente</span>
        <ul>
          {recent.map(r => (
            <li>
              <a href={`/studio?reel=${r.id}`}>
                <span>{r.mode === 'giraffe' ? '🦒' : '🏖️'} {r.title}</span>
                <span class="st-mono st-dim">{timeAgo(r.created_at)} · {STATUS_LABEL[r.status] ?? r.status}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <style is:global>
    :root {
      --night: #0D1B2A; --panel: #13243A; --panel2: #182C46; --cream: #FAF4E8;
      --gold: #FFB300; --orange: #E85D04;
      --serif: 'Fraunces', serif; --sans: 'Inter', sans-serif; --mono: 'JetBrains Mono', monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--sans); background: var(--night); color: var(--cream); min-height: 100vh; }

    .st-top { display: flex; align-items: center; justify-content: space-between; padding: 20px clamp(20px, 4vw, 48px); border-bottom: 1px solid rgba(250,244,232,0.08); }
    .st-back { font-size: 13px; font-weight: 500; color: rgba(250,244,232,0.6); text-decoration: none; }
    .st-back:hover { color: var(--gold); }
    .st-logo { font-family: var(--mono); font-size: 13px; letter-spacing: 0.22em; }
    .st-logo span { color: var(--gold); }
    .st-top-spacer { width: 90px; }

    .st-main { max-width: 880px; margin: 0 auto; padding: clamp(28px, 5vw, 56px) 20px 90px; }
    .st-kicker { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
    .st-head h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(32px, 5vw, 54px); line-height: 1.05; }
    .st-head h1 em { font-style: italic; color: var(--gold); }
    .st-head { margin-bottom: 36px; }

    .st-steps { display: flex; gap: 4px; margin-bottom: 32px; }
    .st-step { flex: 1; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(250,244,232,0.35); padding: 10px 0; border-top: 2px solid rgba(250,244,232,0.12); }
    .st-step i { width: 8px; height: 8px; border-radius: 50%; background: rgba(250,244,232,0.2); }
    .st-step.on { color: var(--gold); border-top-color: var(--gold); }
    .st-step.on i { background: var(--gold); animation: pulse 1.2s ease-in-out infinite; }
    .st-step.done { color: rgba(250,244,232,0.75); border-top-color: rgba(255,179,0,0.5); }
    .st-step.done i { background: #6ee7a0; animation: none; }
    @keyframes pulse { 50% { opacity: 0.35; } }

    .st-card { background: var(--panel); border: 1px solid rgba(250,244,232,0.08); border-radius: 20px; padding: 28px; }
    .st-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 10px; }
    @media (max-width: 600px) { .st-modes { grid-template-columns: 1fr; } }
    .st-mode { text-align: left; background: rgba(250,244,232,0.03); border: 1px solid rgba(250,244,232,0.12); border-radius: 14px; padding: 16px; cursor: pointer; color: var(--cream); transition: all 0.2s; }
    .st-mode.active { border-color: var(--gold); background: rgba(255,179,0,0.08); }
    .st-mode-ic { font-size: 22px; display: block; margin-bottom: 8px; }
    .st-mode strong { display: block; font-size: 14.5px; margin-bottom: 4px; }
    .st-mode span:last-child { display: block; font-size: 12px; color: rgba(250,244,232,0.55); line-height: 1.45; }

    .st-label { display: block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(250,244,232,0.55); margin: 18px 0 7px; }
    .st-hint { text-transform: none; letter-spacing: 0; color: rgba(250,244,232,0.35); }
    .st-input { width: 100%; background: rgba(250,244,232,0.05); border: 1px solid rgba(250,244,232,0.15); border-radius: 12px; padding: 12px 14px; font-size: 14px; color: var(--cream); font-family: inherit; resize: vertical; }
    .st-input:focus { outline: none; border-color: var(--gold); }

    .st-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; padding: 13px 24px; border-radius: 999px; border: none; cursor: pointer; text-decoration: none; color: var(--cream); transition: transform 0.25s cubic-bezier(0.2,0.8,0.2,1), opacity 0.2s; margin-top: 22px; }
    .st-btn:hover { transform: translateY(-2px); }
    .st-btn:disabled { opacity: 0.5; cursor: wait; transform: none; }
    .st-btn-gold { background: linear-gradient(120deg, var(--gold), var(--orange)); color: #16110a; }
    .st-btn-ghost { background: none; border: 1px solid rgba(250,244,232,0.25); }
    .st-btn-sm { font-size: 12.5px; padding: 8px 16px; margin-top: 0; }

    .st-row-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 8px 0 18px; }
    .st-row-head h2 { font-family: var(--serif); font-weight: 300; font-size: 28px; }
    .st-mono { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; color: rgba(250,244,232,0.45); }

    .st-scenes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    @media (max-width: 760px) { .st-scenes { grid-template-columns: 1fr; } }
    .st-scene { background: var(--panel); border: 1px solid rgba(250,244,232,0.1); border-radius: 18px; padding: 18px; display: flex; flex-direction: column; gap: 10px; animation: rise 0.6s cubic-bezier(0.16,1,0.3,1) both; }
    .st-scene:nth-child(2) { animation-delay: 0.08s; } .st-scene:nth-child(3) { animation-delay: 0.16s; }
    @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
    .st-scene-n { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; color: var(--gold); }
    .st-scene textarea { background: rgba(250,244,232,0.04); border: 1px solid rgba(250,244,232,0.12); border-radius: 10px; padding: 9px 11px; font-size: 12.5px; line-height: 1.5; color: var(--cream); font-family: inherit; resize: vertical; }
    .st-scene textarea:focus { outline: none; border-color: var(--gold); }
    .st-scene select { background: var(--panel2); border: 1px solid rgba(250,244,232,0.15); border-radius: 10px; padding: 8px 10px; font-size: 12.5px; color: var(--cream); }
    .st-scene-label { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(250,244,232,0.4); }
    .st-scene img { width: 100%; aspect-ratio: 9/16; object-fit: cover; border-radius: 12px; background: #0a1420; }
    .st-scene-shimmer { width: 100%; aspect-ratio: 9/16; border-radius: 12px; background: linear-gradient(110deg, var(--panel2) 30%, #20375a 50%, var(--panel2) 70%); background-size: 200% 100%; animation: shimmer 1.4s linear infinite; }
    @keyframes shimmer { to { background-position: -200% 0; } }
    .st-scene-status { font-size: 11.5px; color: rgba(250,244,232,0.55); }
    .st-scene-status.err { color: #ff8a8a; }

    .st-gate { text-align: center; background: rgba(255,179,0,0.06); border: 1px solid rgba(255,179,0,0.3); border-radius: 16px; padding: 22px; margin-top: 20px; }
    .st-gate p { font-size: 13px; color: #ffd57a; line-height: 1.55; max-width: 52ch; margin: 0 auto; }

    .st-render { text-align: center; padding: 50px 0; }
    .st-spin { width: 34px; height: 34px; margin: 0 auto 16px; border: 3px solid rgba(255,179,0,0.2); border-top-color: var(--gold); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #render-label { font-size: 14px; color: rgba(250,244,232,0.65); }
    .st-render-dots { display: flex; justify-content: center; gap: 10px; margin-top: 18px; }
    .st-rdot { width: 11px; height: 11px; border-radius: 50%; background: rgba(250,244,232,0.15); transition: background 0.3s; }
    .st-rdot.on { background: var(--gold); animation: pulse 1s ease-in-out infinite; }
    .st-rdot.done { background: #6ee7a0; animation: none; }

    .st-done { text-align: center; }
    .st-done video { width: 100%; max-width: 320px; aspect-ratio: 9/16; border-radius: 18px; border: 1px solid rgba(250,244,232,0.15); background: #000; }
    .st-done .st-row { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }

    .st-error { font-size: 13px; color: #ff8a8a; margin-top: 14px; }

    .st-history { margin-top: 64px; }
    .st-history-label { display: block; margin-bottom: 12px; }
    .st-history ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .st-history a { display: flex; justify-content: space-between; gap: 12px; padding: 13px 16px; border-radius: 13px; background: rgba(250,244,232,0.03); border: 1px solid rgba(250,244,232,0.08); color: var(--cream); text-decoration: none; font-size: 13.5px; font-weight: 600; transition: background 0.2s; }
    .st-history a:hover { background: rgba(250,244,232,0.07); }
    .st-dim { font-weight: 400; }
  </style>

  <script type="application/json" id="poses-json" set:html={JSON.stringify(GIRAFFE_POSES.map(p => ({ id: p.id, label: p.label })))} />

  <script>
    const $ = (id: string) => document.getElementById(id)!;
    const POSES: Array<{ id: string; label: string }> = JSON.parse($('poses-json').textContent!);

    let mode: 'scene' | 'giraffe' = 'scene';
    let reelId: string | null = null;
    let board: any = null;
    let pollTimer: ReturnType<typeof setTimeout> | null = null;

    document.querySelectorAll<HTMLButtonElement>('.st-mode').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('.st-mode').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      mode = b.dataset.mode as any;
      $('dialogue-row').hidden = mode !== 'giraffe';
    }));

    const api = async (path: string, opts: RequestInit = {}) => {
      const res = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Eroare.');
      return data;
    };

    function setSteps(on: string, done: string[]) {
      $('steps').hidden = false;
      document.querySelectorAll<HTMLElement>('.st-step').forEach(s => {
        s.classList.toggle('on', s.dataset.step === on);
        s.classList.toggle('done', done.includes(s.dataset.step!));
      });
    }
    function showOnly(ids: string[]) {
      ['card-brief', 'card-story', 'card-images', 'card-final', 'head-intro', 'history'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.hidden = !ids.includes(id);
      });
    }

    // ── Brief → create + storyboard
    $('btn-create').addEventListener('click', async () => {
      const btn = $('btn-create') as HTMLButtonElement, err = $('brief-error');
      err.hidden = true; btn.disabled = true; btn.textContent = 'Domnul Girafă gândește…';
      try {
        const { id } = await api('/api/studio/reels', { method: 'POST', body: JSON.stringify({
          mode,
          title: ($('title') as HTMLInputElement).value,
          scenePrompt: ($('scene') as HTMLTextAreaElement).value,
          dialogue: mode === 'giraffe' ? ($('dialogue') as HTMLTextAreaElement).value : undefined,
        }) });
        reelId = id;
        const { storyboard } = await api(`/api/studio/reels/${id}/storyboard`, { method: 'POST' });
        board = storyboard;
        renderStoryboard();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; btn.textContent = 'Generează storyboard-ul →'; }
    });

    function renderStoryboard() {
      setSteps('story', []);
      showOnly(['card-story']);
      const grid = $('story-grid');
      grid.innerHTML = '';
      board.scenes.forEach((s: any) => {
        const card = document.createElement('article');
        card.className = 'st-scene';
        card.innerHTML = `
          <span class="st-scene-n">SCENA ${s.n} · 8s</span>
          <span class="st-scene-label">Cadrul</span>
          <textarea rows="3" data-f="description" data-n="${s.n}"></textarea>
          ${mode === 'giraffe' ? `
            <span class="st-scene-label">Replica scenei</span>
            <textarea rows="2" data-f="dialogue" data-n="${s.n}"></textarea>
            <span class="st-scene-label">Poza girafei</span>
            <select data-f="pose" data-n="${s.n}">${POSES.map(p => `<option value="${p.id}">${p.label}</option>`).join('')}</select>
          ` : ''}`;
        grid.appendChild(card);
        (card.querySelector('[data-f="description"]') as HTMLTextAreaElement).value = s.description;
        if (mode === 'giraffe') {
          (card.querySelector('[data-f="dialogue"]') as HTMLTextAreaElement).value = s.dialogue ?? '';
          (card.querySelector('[data-f="pose"]') as HTMLSelectElement).value = s.pose ?? POSES[0].id;
        }
      });
    }

    $('btn-restory').addEventListener('click', async () => {
      const btn = $('btn-restory') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '↻ Se rescrie…';
      try { board = (await api(`/api/studio/reels/${reelId}/storyboard`, { method: 'POST' })).storyboard; renderStoryboard(); }
      catch {} finally { btn.disabled = false; btn.textContent = '↻ Alt storyboard'; }
    });

    $('btn-images').addEventListener('click', async () => {
      const btn = $('btn-images') as HTMLButtonElement, err = $('story-error');
      err.hidden = true; btn.disabled = true;
      try {
        // save edits, then fire all 3 image jobs
        const map: Record<string, any> = {};
        document.querySelectorAll<HTMLInputElement>('#story-grid [data-n]').forEach((el: any) => {
          const n = Number(el.dataset.n);
          map[n] = map[n] ?? { n };
          map[n][el.dataset.f] = el.value;
        });
        await api(`/api/studio/reels/${reelId}/storyboard`, { method: 'PATCH', body: JSON.stringify({ scenes: Object.values(map) }) });
        await api(`/api/studio/reels/${reelId}/generate-image`, { method: 'POST', body: '{}' });
        poll();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; btn.disabled = false; }
    });

    // ── Images + gate
    function renderImages(reel: any) {
      setSteps(reel.status === 'image_ready' ? 'approve' : 'image', reel.status === 'image_ready' ? ['story', 'image'] : ['story']);
      showOnly(['card-images']);
      const grid = $('image-grid');
      grid.innerHTML = '';
      reel.storyboard.scenes.forEach((s: any) => {
        const card = document.createElement('article');
        card.className = 'st-scene';
        const st = s.image.status;
        card.innerHTML = `
          <span class="st-scene-n">SCENA ${s.n}</span>
          ${st === 'ready' ? `<img src="${s.image.url}" alt="Scena ${s.n}" />`
            : st === 'failed' ? `<div class="st-scene-shimmer" style="animation:none"></div><span class="st-scene-status err">${s.image.error ?? 'Eroare'}</span>`
            : '<div class="st-scene-shimmer"></div><span class="st-scene-status">Se generează…</span>'}
          ${['ready', 'failed'].includes(st) ? `<button class="st-btn st-btn-ghost st-btn-sm js-regen" data-n="${s.n}" type="button">↻ Regenerează</button>` : ''}`;
        grid.appendChild(card);
      });
      grid.querySelectorAll<HTMLButtonElement>('.js-regen').forEach(b => b.addEventListener('click', async () => {
        b.disabled = true;
        await api(`/api/studio/reels/${reelId}/generate-image`, { method: 'POST', body: JSON.stringify({ scene: Number(b.dataset.n) }) }).catch(() => {});
        poll();
      }));
      $('gate').hidden = reel.status !== 'image_ready';
    }

    $('btn-approve').addEventListener('click', async () => {
      const btn = $('btn-approve') as HTMLButtonElement, err = $('image-error');
      err.hidden = true; btn.disabled = true; btn.textContent = 'Pornim camerele…';
      try {
        await api(`/api/studio/reels/${reelId}/approve`, { method: 'POST' });
        await api(`/api/studio/reels/${reelId}/generate-video`, { method: 'POST' });
        poll();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; btn.textContent = 'Aprobă tot → generează filmul'; }
    });

    // ── Render + final
    function renderProgress(reel: any) {
      setSteps('video', ['story', 'image', 'approve']);
      showOnly(['card-final']);
      $('render-progress').hidden = false; $('done').hidden = true; $('fail').hidden = true;
      $('render-label').textContent = reel.status === 'audio_generating'
        ? 'Domnul Girafă intră în cabina de voce…'
        : 'Animăm cele 3 scene ancorate…';
      const dots = $('render-dots');
      dots.innerHTML = '';
      (reel.storyboard?.scenes ?? []).forEach((s: any) => {
        const d = document.createElement('span');
        d.className = 'st-rdot' + (s.video.status === 'ready' ? ' done' : s.video.status === 'generating' ? ' on' : '');
        dots.appendChild(d);
      });
    }
    function renderDone(reel: any) {
      setSteps('', ['story', 'image', 'approve', 'video']);
      showOnly(['card-final']);
      $('render-progress').hidden = true; $('fail').hidden = true; $('done').hidden = false;
      ($('final-video') as HTMLVideoElement).src = reel.video_url;
      ($('btn-download') as HTMLAnchorElement).href = reel.video_url;
    }
    function renderFail(reel: any) {
      showOnly(['card-final']);
      $('render-progress').hidden = true; $('done').hidden = true; $('fail').hidden = false;
      $('fail-msg').textContent = reel.error_message ?? 'A apărut o eroare.';
      ($('btn-retry') as HTMLButtonElement).dataset.kind = reel.status === 'image_failed' ? 'image' : 'video';
    }
    $('btn-retry').addEventListener('click', async () => {
      const kind = ($('btn-retry') as HTMLButtonElement).dataset.kind;
      await api(`/api/studio/reels/${reelId}/generate-${kind}`, { method: 'POST', body: '{}' }).catch(() => {});
      poll();
    });
    $('btn-new').addEventListener('click', () => { window.location.href = '/studio'; });

    // ── Poll loop drives everything after storyboard
    async function poll() {
      if (!reelId) return;
      if (pollTimer) clearTimeout(pollTimer);
      try {
        const { reel } = await api(`/api/studio/reels/${reelId}`);
        mode = reel.mode;
        board = reel.storyboard ?? board;
        switch (reel.status) {
          case 'storyboard_ready': renderStoryboard(); return;
          case 'image_generating': renderImages(reel); break;
          case 'image_ready': renderImages(reel); return;
          case 'approved': case 'audio_generating': case 'video_generating': renderProgress(reel); break;
          case 'complete': renderDone(reel); return;
          case 'image_failed': case 'video_failed': renderFail(reel); return;
          default: return;
        }
      } catch {}
      pollTimer = setTimeout(poll, 2500);
    }

    // Deep-link resume
    const resumeId = new URLSearchParams(window.location.search).get('reel');
    if (resumeId) { reelId = resumeId; showOnly([]); poll(); }
  </script>
</body>
</html>
