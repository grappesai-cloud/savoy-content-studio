---
// Client dashboard — the simple flow, grappes style (cream/ink editorial).
// 01 caracter → 02 idee → 03 text (OK-ul clientului) → 04 imagini
// (generate SAU încărcate) → 05 video. Reuses the whole studio pipeline;
// /studio (night/gold, jury demo) stays untouched.
import { listReels } from '../../lib/studio/db';
import { listCharacters } from '../../lib/studio/characters';

const authUser = Astro.locals.user;
if (!authUser) return Astro.redirect('/sign-in?next=/dashboard');

const [recent, characters] = await Promise.all([
  listReels(authUser.id),
  listCharacters(authUser.id),
]);

function timeAgo(d: Date | string): string {
  const diff = Date.now() - new Date(d).getTime();
  const m = Math.floor(diff / 60000), h = Math.floor(diff / 3600000), day = Math.floor(diff / 86400000);
  if (m < 1) return 'acum';
  if (h < 1) return `acum ${m} min`;
  if (day < 1) return `acum ${h}h`;
  return `acum ${day} zile`;
}
const STATUS_LABEL: Record<string, string> = {
  draft: 'Ciornă', storyboard_ready: 'Text scris',
  image_generating: 'Imagini…', image_ready: 'Așteaptă aprobare', image_failed: 'Eroare imagine',
  approved: 'Aprobat', audio_generating: 'Voce…', video_generating: 'Video…', assembling: 'Montaj…',
  video_failed: 'Eroare video', complete: 'Gata',
};
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Studio · grappes</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="g-top">
    <span class="g-logo">grappes<span>·</span>studio</span>
    <div class="g-top-links">
      <a href="/studio">Content Studio</a>
      <a href="/social">Social</a>
      <a href="/savoy/admin">Admin</a>
    </div>
  </nav>

  <main class="g-main">
    <header class="g-head" id="head-intro">
      <p class="g-kicker">De la idee la reel</p>
      <h1>Spui ce ai de zis.<br /><em>Restul e treaba noastră.</em></h1>
    </header>

    <!-- Progress rail -->
    <div class="g-rail" id="rail" hidden>
      <span class="g-rail-step" data-step="char">01 Caracter</span>
      <span class="g-rail-step" data-step="idea">02 Idee</span>
      <span class="g-rail-step" data-step="text">03 Text</span>
      <span class="g-rail-step" data-step="image">04 Imagini</span>
      <span class="g-rail-step" data-step="video">05 Film</span>
    </div>

    <!-- 01 · Caracterul -->
    <section class="g-block" id="block-char">
      <h2><span class="g-n">01</span>Cine vorbește?</h2>
      <div class="g-chars" id="char-grid">
        <button class="g-char active" data-id="" type="button">
          <img src="/studio/poses/walk.png" alt="Domnul Girafă" />
          <strong>Domnul Girafă</strong>
          <span>mascota Savoy</span>
        </button>
        {characters.map(c => (
          <button class="g-char" data-id={c.id} type="button">
            <span class="g-char-acts">
              <span class="g-char-act js-char-addimg" role="button" title="Adaugă imagini de referință">+</span>
              <span class="g-char-act js-char-del" role="button" title="Șterge caracterul">×</span>
            </span>
            <img src={c.master_image_url} alt={c.name} />
            <strong>{c.name}</strong>
            <span class="js-char-sub">{(c.reference_image_urls?.length ?? 0) > 0 ? `caracterul tău · ${c.reference_image_urls.length + 1} imagini` : 'caracterul tău'}</span>
          </button>
        ))}
        <button class="g-char g-char-add" id="char-add" type="button">
          <span class="g-char-plus">+</span>
          <strong>Caracter nou</strong>
          <span>încarci imaginea lui</span>
        </button>
      </div>
      <div class="g-char-form" id="char-form" hidden>
        <label class="g-label" for="char-name">Numele caracterului</label>
        <input id="char-name" class="g-input" type="text" maxlength="60" placeholder="ex: Bobby Bursucul" />
        <label class="g-label" for="char-file">Imaginile lui <span class="g-hint">(PNG/JPG, pe fundal simplu — prima e cea master, poți selecta mai multe)</span></label>
        <input id="char-file" class="g-input" type="file" multiple accept="image/png,image/jpeg,image/webp" />
        <div class="g-row">
          <button class="g-btn" id="char-save" type="button">Salvează caracterul</button>
          <button class="g-btn g-btn-ghost" id="char-cancel" type="button">Renunță</button>
        </div>
        <p class="g-error" id="char-error" hidden></p>
      </div>
      <input id="char-ref-file" class="g-upl" type="file" multiple accept="image/png,image/jpeg,image/webp" />
    </section>

    <!-- 02 · Ideea -->
    <section class="g-block" id="block-idea">
      <h2><span class="g-n">02</span>Care e ideea?</h2>
      <label class="g-label" for="title">Nume reel</label>
      <input id="title" class="g-input" type="text" maxlength="80" placeholder="ex: Weekend la piscină" />
      <label class="g-label" for="idea">Despre ce vorbește <span id="idea-char-name">Domnul Girafă</span>?</label>
      <textarea id="idea" class="g-input" rows="3" placeholder="ex: invită familiile la brunch-ul de duminică, cu piscina și locul de joacă incluse"></textarea>
      <button class="g-btn" id="btn-text" type="button">Scrie textul →</button>
      <p class="g-error" id="idea-error" hidden></p>
    </section>

    <!-- 03 · Textul -->
    <section class="g-block" id="block-text" hidden>
      <div class="g-block-head">
        <h2><span class="g-n">03</span>Textul</h2>
        <button class="g-btn g-btn-ghost g-btn-sm" id="btn-retext" type="button">↻ Alt text</button>
      </div>
      <p class="g-note">Tot ce spune caracterul în video, scris de AI din ideea ta. Corectează direct în casetă.</p>
      <div class="g-scenes g-scenes-single" id="text-grid"></div>
      <button class="g-btn" id="btn-approve-text" type="button">✓ Clientul aprobă textul</button>
      <p class="g-error" id="text-error" hidden></p>
    </section>

    <!-- 04 · Imaginile -->
    <section class="g-block" id="block-image" hidden>
      <h2><span class="g-n">04</span>Imaginile</h2>
      <p class="g-note">O singură imagine pentru tot videoul: încarcă fundalul tău (girafa intră singură în cadru) sau lasă AI-ul să genereze unul. Nimic nu merge mai departe fără aprobarea ta.</p>
      <div class="g-scenes g-scenes-single" id="image-grid"></div>
      <button class="g-btn" id="btn-gen-images" type="button">Generează imaginea →</button>
      <div class="g-gate" id="gate" hidden>
        <p>Verifică fiecare cadru. Videoul costă bani și pornește doar după OK-ul tău.</p>
        <button class="g-btn" id="btn-approve" type="button">Aprobă tot → generează filmul</button>
      </div>
      <p class="g-error" id="image-error" hidden></p>
    </section>

    <!-- 05 · Filmul -->
    <section class="g-block" id="block-video" hidden>
      <h2><span class="g-n">05</span>Filmul</h2>
      <div class="g-render" id="render-progress" hidden>
        <div class="g-spin"></div>
        <p id="render-label">Animăm scenele…</p>
        <div class="g-dots" id="render-dots"></div>
      </div>
      <div class="g-done" id="done" hidden>
        <video id="final-video" controls playsinline></video>
        <div class="g-row g-center">
          <a class="g-btn" id="btn-download" download>Descarcă reel-ul</a>
          <button class="g-btn g-btn-ghost" id="btn-new" type="button">Reel nou</button>
        </div>
      </div>
      <div id="fail" hidden>
        <p class="g-error" id="fail-msg"></p>
        <button class="g-btn g-btn-ghost" id="btn-retry" type="button">Încearcă din nou</button>
      </div>
    </section>

    {recent.length > 0 && (
      <section class="g-history" id="history">
        <span class="g-mono">Reels recente</span>
        <ul>
          {recent.map(r => (
            <li>
              <a href={`/dashboard?reel=${r.id}`}>
                <span>{r.title}</span>
                <span class="g-mono g-dim">{timeAgo(r.created_at)} · {STATUS_LABEL[r.status] ?? r.status}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <style is:global>
    :root {
      --cream: #F4EFE4; --paper: #FBF8F1; --ink: #141310; --ink-60: rgba(20,19,16,0.6);
      --ink-35: rgba(20,19,16,0.35); --line: rgba(20,19,16,0.14); --accent: #E85D04;
      --serif: 'Fraunces', serif; --sans: 'Inter', sans-serif; --mono: 'JetBrains Mono', monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); background: var(--cream); color: var(--ink); min-height: 100vh; }
    ::selection { background: var(--ink); color: var(--cream); }

    .g-top { display: flex; align-items: center; justify-content: space-between; padding: 22px clamp(20px, 4vw, 56px); border-bottom: 1px solid var(--line); }
    .g-logo { font-family: var(--mono); font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; }
    .g-logo span { color: var(--accent); }
    .g-top-links { display: flex; gap: 22px; }
    .g-top-links a { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-60); text-decoration: none; }
    .g-top-links a:hover { color: var(--ink); }

    .g-main { max-width: 820px; margin: 0 auto; padding: clamp(32px, 6vw, 72px) 20px 110px; }
    .g-kicker { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-60); margin-bottom: 16px; }
    .g-head h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(34px, 5.5vw, 58px); line-height: 1.04; letter-spacing: -0.01em; }
    .g-head h1 em { font-style: italic; }
    .g-head { margin-bottom: clamp(36px, 6vw, 64px); }

    .g-rail { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 40px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
    .g-rail-step { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-35); transition: color 0.2s; }
    .g-rail-step.on { color: var(--ink); }
    .g-rail-step.done { color: var(--ink-60); text-decoration: line-through; text-decoration-thickness: 1px; }

    .g-block { margin-bottom: clamp(40px, 7vw, 72px); }
    .g-block h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 3.4vw, 34px); margin-bottom: 18px; display: flex; align-items: baseline; gap: 14px; }
    .g-n { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; color: var(--accent); }
    .g-block-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
    .g-block-head h2 { margin-bottom: 18px; }
    .g-note { font-size: 13.5px; color: var(--ink-60); line-height: 1.6; max-width: 56ch; margin-bottom: 20px; }

    .g-chars { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
    .g-char { position: relative; text-align: left; background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 14px; cursor: pointer; color: var(--ink); font-family: inherit; transition: border-color 0.2s, transform 0.25s cubic-bezier(0.2,0.8,0.2,1); }
    .g-char-acts { position: absolute; top: 20px; right: 20px; display: flex; gap: 6px; opacity: 0; transition: opacity 0.2s; z-index: 2; }
    .g-char:hover .g-char-acts, .g-char:focus-within .g-char-acts { opacity: 1; }
    .g-char-act { width: 26px; height: 26px; border-radius: 50%; background: var(--cream); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 15px; line-height: 1; color: var(--ink-60); }
    .g-char-act:hover { color: var(--ink); border-color: var(--ink); }
    .js-char-del:hover { color: #b3261e; border-color: #b3261e; }
    .g-char:hover { transform: translateY(-2px); }
    .g-char.active { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }
    .g-char img { width: 100%; aspect-ratio: 3/4; object-fit: contain; background: #fff; border-radius: 2px; margin-bottom: 10px; }
    .g-char strong { display: block; font-size: 13.5px; font-weight: 600; }
    .g-char span:last-child { display: block; font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-35); margin-top: 3px; }
    .g-char-add { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; min-height: 200px; border-style: dashed; }
    .g-char-plus { font-family: var(--serif); font-size: 40px; font-weight: 300; line-height: 1; margin-bottom: 8px; color: var(--ink-60); }
    .g-char-form { margin-top: 18px; padding: 20px; background: var(--paper); border: 1px solid var(--line); border-radius: 4px; }

    .g-label { display: block; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-60); margin: 18px 0 7px; }
    .g-label:first-child { margin-top: 0; }
    .g-hint { text-transform: none; letter-spacing: 0; color: var(--ink-35); }
    .g-input { width: 100%; background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 12px 14px; font-size: 14px; color: var(--ink); font-family: inherit; resize: vertical; }
    .g-input:focus { outline: none; border-color: var(--ink); }

    .g-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; padding: 13px 26px; border-radius: 999px; border: 1px solid var(--ink); background: var(--ink); color: var(--cream); cursor: pointer; text-decoration: none; font-family: inherit; transition: transform 0.25s cubic-bezier(0.2,0.8,0.2,1), opacity 0.2s; margin-top: 22px; }
    .g-btn:hover { transform: translateY(-2px); }
    .g-btn:disabled { opacity: 0.45; cursor: wait; transform: none; }
    .g-btn-ghost { background: none; color: var(--ink); }
    .g-btn-sm { font-size: 12px; padding: 8px 16px; margin-top: 0; }
    .g-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
    .g-center { justify-content: center; }

    .g-scenes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    @media (max-width: 720px) { .g-scenes { grid-template-columns: 1fr; } }
    /* simple flow: one text box / one image for the whole reel */
    .g-scenes-single { grid-template-columns: 1fr; max-width: 460px; }
    .g-scenes-single img { max-height: 560px; object-fit: contain; }
    .g-scene { background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 16px; display: flex; flex-direction: column; gap: 9px; animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) both; }
    .g-scene:nth-child(2) { animation-delay: 0.07s; } .g-scene:nth-child(3) { animation-delay: 0.14s; }
    @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
    .g-scene-n { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.18em; color: var(--accent); }
    .g-scene-label { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-35); }
    .g-scene textarea { background: #fff; border: 1px solid var(--line); border-radius: 3px; padding: 9px 11px; font-size: 12.5px; line-height: 1.55; color: var(--ink); font-family: inherit; resize: vertical; }
    .g-scene textarea:focus { outline: none; border-color: var(--ink); }
    .g-scene img { width: 100%; aspect-ratio: 9/16; object-fit: cover; border-radius: 3px; background: #e9e3d4; }
    .g-shimmer { width: 100%; aspect-ratio: 9/16; border-radius: 3px; background: linear-gradient(110deg, #ece6d8 30%, #f7f3e9 50%, #ece6d8 70%); background-size: 200% 100%; animation: shimmer 1.4s linear infinite; }
    @keyframes shimmer { to { background-position: -200% 0; } }
    .g-scene-status { font-size: 11.5px; color: var(--ink-60); }
    .g-scene-status.err { color: #b3261e; }
    .g-scene .g-mini { font-size: 11.5px; font-weight: 600; padding: 7px 13px; border-radius: 999px; border: 1px solid var(--ink); background: none; color: var(--ink); cursor: pointer; font-family: inherit; }
    .g-scene .g-mini:disabled { opacity: 0.45; cursor: wait; }
    .g-scene .g-mini.primary { background: var(--ink); color: var(--cream); }
    .g-upl { display: none; }

    .g-gate { text-align: center; background: var(--paper); border: 1px solid var(--ink); border-radius: 4px; padding: 22px; margin-top: 22px; }
    .g-gate p { font-size: 13px; color: var(--ink-60); line-height: 1.55; max-width: 50ch; margin: 0 auto; }

    .g-render { text-align: center; padding: 44px 0; }
    .g-spin { width: 30px; height: 30px; margin: 0 auto 16px; border: 2px solid var(--line); border-top-color: var(--ink); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #render-label { font-size: 14px; color: var(--ink-60); }
    .g-dots { display: flex; justify-content: center; gap: 10px; margin-top: 18px; }
    .g-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--line); transition: background 0.3s; }
    .g-dot.on { background: var(--accent); animation: pulse 1s ease-in-out infinite; }
    .g-dot.done { background: var(--ink); animation: none; }
    @keyframes pulse { 50% { opacity: 0.35; } }

    .g-done { text-align: center; }
    .g-done video { width: 100%; max-width: 320px; aspect-ratio: 9/16; border-radius: 4px; border: 1px solid var(--ink); background: #000; }

    .g-error { font-size: 13px; color: #b3261e; margin-top: 14px; }
    .g-mono { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-35); }
    .g-dim { font-weight: 400; text-transform: none; letter-spacing: 0.04em; }

    .g-history { margin-top: 72px; border-top: 1px solid var(--line); padding-top: 18px; }
    .g-history > .g-mono { display: block; margin-bottom: 12px; }
    .g-history ul { list-style: none; display: flex; flex-direction: column; }
    .g-history a { display: flex; justify-content: space-between; gap: 12px; padding: 12px 2px; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: 13.5px; font-weight: 600; }
    .g-history a:hover { background: var(--paper); }
  </style>

  <script>
    import { upload } from '@vercel/blob/client';

    const $ = (id: string) => document.getElementById(id)!;
    const api = async (path: string, opts: RequestInit = {}) => {
      const res = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Eroare.');
      return data;
    };

    let characterId = '';            // '' = Domnul Girafă
    let characterName = 'Domnul Girafă';
    let reelId: string | null = null;
    let board: any = null;
    let pollTimer: ReturnType<typeof setTimeout> | null = null;

    // ── 01 · character selection + creation ─────────────────────────────────
    function bindCharButtons() {
      document.querySelectorAll<HTMLButtonElement>('.g-char:not(.g-char-add)').forEach(b => {
        b.onclick = () => {
          document.querySelectorAll('.g-char').forEach(x => x.classList.remove('active'));
          b.classList.add('active');
          characterId = b.dataset.id ?? '';
          characterName = b.querySelector('strong')!.textContent!;
          $('idea-char-name').textContent = characterName;
        };
      });
      // delete a custom character
      document.querySelectorAll<HTMLElement>('.js-char-del').forEach(el => {
        el.onclick = async (ev) => {
          ev.stopPropagation();
          const card = el.closest<HTMLButtonElement>('.g-char')!;
          const name = card.querySelector('strong')!.textContent!;
          if (!confirm(`Ștergi caracterul „${name}”? Reels-urile vechi rămân, dar trec pe Domnul Girafă.`)) return;
          try {
            await api(`/api/studio/characters/${card.dataset.id}`, { method: 'DELETE' });
            const wasActive = card.classList.contains('active');
            card.remove();
            if (wasActive) document.querySelector<HTMLButtonElement>('.g-char:not(.g-char-add)')!.click();
          } catch (e: any) { alert(e.message); }
        };
      });
      // add reference images to a custom character
      document.querySelectorAll<HTMLElement>('.js-char-addimg').forEach(el => {
        el.onclick = (ev) => {
          ev.stopPropagation();
          refTargetCard = el.closest<HTMLButtonElement>('.g-char')!;
          ($('char-ref-file') as HTMLInputElement).click();
        };
      });
    }
    let refTargetCard: HTMLButtonElement | null = null;
    $('char-ref-file').addEventListener('change', async () => {
      const inp = $('char-ref-file') as HTMLInputElement;
      const files = Array.from(inp.files ?? []);
      inp.value = '';
      if (!files.length || !refTargetCard) return;
      const card = refTargetCard;
      const sub = card.querySelector<HTMLElement>('.js-char-sub')!;
      const prev = sub.textContent;
      sub.textContent = 'se încarcă imaginile…';
      try {
        const urls: string[] = [];
        for (const file of files) {
          const blob = await upload(`studio/characters/${file.name}`, file, {
            access: 'public', handleUploadUrl: '/api/studio/upload',
          });
          urls.push(blob.url);
        }
        sub.textContent = 'AI-ul reînvață caracterul…';
        const { character } = await api(`/api/studio/characters/${card.dataset.id}`, {
          method: 'POST', body: JSON.stringify({ referenceImageUrls: urls }),
        });
        const total = 1 + (character.reference_image_urls?.length ?? 0);
        sub.textContent = total > 1 ? `caracterul tău · ${total} imagini` : 'caracterul tău';
      } catch (e: any) {
        sub.textContent = prev;
        alert(e.message);
      }
    });
    bindCharButtons();

    $('char-add').addEventListener('click', () => { $('char-form').hidden = false; });
    $('char-cancel').addEventListener('click', () => { $('char-form').hidden = true; });
    $('char-save').addEventListener('click', async () => {
      const btn = $('char-save') as HTMLButtonElement, err = $('char-error');
      const name = ($('char-name') as HTMLInputElement).value.trim();
      const files = Array.from(($('char-file') as HTMLInputElement).files ?? []);
      err.hidden = true;
      if (name.length < 2) { err.textContent = 'Dă-i un nume caracterului.'; err.hidden = false; return; }
      if (!files.length) { err.textContent = 'Încarcă cel puțin imaginea master.'; err.hidden = false; return; }
      btn.disabled = true; btn.textContent = files.length > 1 ? 'Se încarcă imaginile…' : 'Se încarcă imaginea…';
      try {
        // first file = master, the rest = extra reference images
        const urls: string[] = [];
        for (const file of files.slice(0, 8)) {
          const blob = await upload(`studio/characters/${file.name}`, file, {
            access: 'public', handleUploadUrl: '/api/studio/upload',
          });
          urls.push(blob.url);
        }
        btn.textContent = 'AI-ul învață caracterul…';
        const { character } = await api('/api/studio/characters', {
          method: 'POST', body: JSON.stringify({ name, imageUrl: urls[0], referenceImageUrls: urls.slice(1) }),
        });
        // insert the new card before the "+" card, select it
        const card = document.createElement('button');
        card.className = 'g-char'; card.type = 'button'; card.dataset.id = character.id;
        const total = 1 + (character.reference_image_urls?.length ?? 0);
        card.innerHTML = `
          <span class="g-char-acts">
            <span class="g-char-act js-char-addimg" role="button" title="Adaugă imagini de referință">+</span>
            <span class="g-char-act js-char-del" role="button" title="Șterge caracterul">×</span>
          </span>
          <img src="${character.master_image_url}" alt="" /><strong></strong>
          <span class="js-char-sub">${total > 1 ? `caracterul tău · ${total} imagini` : 'caracterul tău'}</span>`;
        card.querySelector('strong')!.textContent = character.name;
        $('char-grid').insertBefore(card, $('char-add'));
        bindCharButtons();
        (card as HTMLButtonElement).click();
        $('char-form').hidden = true;
        ($('char-name') as HTMLInputElement).value = '';
        ($('char-file') as HTMLInputElement).value = '';
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; btn.textContent = 'Salvează caracterul'; }
    });

    // ── step visibility ──────────────────────────────────────────────────────
    function setRail(on: string, done: string[]) {
      $('rail').hidden = false;
      document.querySelectorAll<HTMLElement>('.g-rail-step').forEach(s => {
        s.classList.toggle('on', s.dataset.step === on);
        s.classList.toggle('done', done.includes(s.dataset.step!));
      });
    }
    function showOnly(ids: string[]) {
      ['head-intro', 'block-char', 'block-idea', 'block-text', 'block-image', 'block-video', 'history'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.hidden = !ids.includes(id);
      });
    }

    // ── 02 · idea → reel + script ────────────────────────────────────────────
    $('btn-text').addEventListener('click', async () => {
      const btn = $('btn-text') as HTMLButtonElement, err = $('idea-error');
      err.hidden = true; btn.disabled = true; btn.textContent = 'AI-ul scrie…';
      try {
        if (!reelId) {
          const { id } = await api('/api/studio/reels', { method: 'POST', body: JSON.stringify({
            mode: 'giraffe',
            title: ($('title') as HTMLInputElement).value,
            scenePrompt: ($('idea') as HTMLTextAreaElement).value,
            characterId: characterId || undefined,
          }) });
          reelId = id;
        }
        const { storyboard } = await api(`/api/studio/reels/${reelId}/storyboard`, { method: 'POST', body: '{}' });
        board = storyboard;
        renderText();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; btn.textContent = 'Scrie textul →'; }
    });

    // ── 03 · the script + client OK ──────────────────────────────────────────
    // Simple flow: ONE box with everything the character says. The server
    // re-splits it into ≤5s scenes on save — the client never sees scenes.
    function renderText() {
      setRail('text', ['char', 'idea']);
      showOnly(['block-text']);
      const grid = $('text-grid');
      grid.innerHTML = '';
      const card = document.createElement('article');
      card.className = 'g-scene';
      card.innerHTML = `
        <span class="g-scene-label">Ce spune caracterul</span>
        <textarea rows="7" id="simple-text"></textarea>`;
      grid.appendChild(card);
      (card.querySelector('#simple-text') as HTMLTextAreaElement).value =
        board.scenes.map((s: any) => s.dialogue).filter(Boolean).join(' ');
    }

    $('btn-retext').addEventListener('click', async () => {
      const btn = $('btn-retext') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '↻ Se rescrie…';
      try {
        board = (await api(`/api/studio/reels/${reelId}/storyboard`, { method: 'POST', body: JSON.stringify({ fresh: true }) })).storyboard;
        renderText();
      } catch {} finally { btn.disabled = false; btn.textContent = '↻ Alt text'; }
    });

    async function saveTextEdits() {
      const text = (document.getElementById('simple-text') as HTMLTextAreaElement).value.trim();
      board = (await api(`/api/studio/reels/${reelId}/storyboard`, { method: 'PATCH', body: JSON.stringify({ simpleText: text }) })).storyboard;
    }

    $('btn-approve-text').addEventListener('click', async () => {
      const btn = $('btn-approve-text') as HTMLButtonElement, err = $('text-error');
      err.hidden = true; btn.disabled = true;
      try {
        await saveTextEdits();
        await api(`/api/studio/reels/${reelId}/approve-text`, { method: 'POST' });
        renderImageChoice();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; }
    });

    // ── 04 · ONE image for the whole reel: generate OR upload a background ──
    // The single anchor (giraffe mid-ground + shadow) serves every ≤5s scene;
    // scene 1 carries the state, the rest mirror it server-side.
    function renderImageChoice() {
      setRail('image', ['char', 'idea', 'text']);
      showOnly(['block-image']);
      $('gate').hidden = true;
      const grid = $('image-grid');
      grid.innerHTML = '';
      const s = board.scenes[0];
      const st = s?.image?.status ?? 'pending';
      const card = document.createElement('article');
      card.className = 'g-scene';
      card.innerHTML = `
        ${st === 'ready' ? `<img src="${s.image.url}" alt="Imaginea reelului" />`
          : st === 'generating' ? '<div class="g-shimmer"></div><span class="g-scene-status">Se generează…</span>'
          : st === 'failed' ? `<div class="g-shimmer" style="animation:none"></div><span class="g-scene-status err">${s.image.error ?? 'Eroare'}</span>`
          : '<div class="g-shimmer" style="animation:none"></div><span class="g-scene-status">Generează una din idee, sau încarcă fundalul tău.</span>'}
        <div class="g-row">
          ${st === 'ready' ? `<button class="g-mini js-regen" type="button">↻ Regenerează</button>` : ''}
          ${st !== 'generating' ? `<button class="g-mini js-upl-btn" type="button">Încarcă fundalul tău</button>` : ''}
        </div>
        <input class="g-upl" type="file" accept="image/png,image/jpeg,image/webp" />`;
      grid.appendChild(card);
      const regen = grid.querySelector<HTMLButtonElement>('.js-regen');
      if (regen) regen.onclick = async () => {
        regen.disabled = true;
        await api(`/api/studio/reels/${reelId}/generate-image`, { method: 'POST', body: JSON.stringify({ single: true }) }).catch(() => {});
        poll();
      };
      const uplBtn = grid.querySelector<HTMLButtonElement>('.js-upl-btn');
      if (uplBtn) uplBtn.onclick = () => grid.querySelector<HTMLInputElement>('.g-upl')!.click();
      const inp = grid.querySelector<HTMLInputElement>('.g-upl')!;
      inp.onchange = async () => {
        const file = inp.files?.[0];
        if (!file) return;
        const err = $('image-error');
        err.hidden = true;
        try {
          const blob = await upload(`studio/backgrounds/${file.name}`, file, {
            access: 'public', handleUploadUrl: '/api/studio/upload',
          });
          await api(`/api/studio/reels/${reelId}/set-image`, {
            method: 'POST', body: JSON.stringify({ background: true, imageUrl: blob.url }),
          });
          poll();
        } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      };
      const allReady = board.scenes.every((sc: any) => sc.image?.status === 'ready');
      $('btn-gen-images').hidden = !['pending', 'failed'].includes(st);
      $('gate').hidden = !allReady;
    }

    $('btn-gen-images').addEventListener('click', async () => {
      const btn = $('btn-gen-images') as HTMLButtonElement, err = $('image-error');
      err.hidden = true; btn.disabled = true;
      try {
        await api(`/api/studio/reels/${reelId}/generate-image`, { method: 'POST', body: JSON.stringify({ single: true }) });
        poll();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; }
    });

    $('btn-approve').addEventListener('click', async () => {
      const btn = $('btn-approve') as HTMLButtonElement, err = $('image-error');
      err.hidden = true; btn.disabled = true; btn.textContent = 'Pornim camerele…';
      try {
        await api(`/api/studio/reels/${reelId}/approve`, { method: 'POST' });
        await api(`/api/studio/reels/${reelId}/generate-video`, { method: 'POST' });
        poll();
      } catch (e: any) { err.textContent = e.message; err.hidden = false; }
      finally { btn.disabled = false; btn.textContent = 'Aprobă tot → generează filmul'; }
    });

    // ── 05 · render + final ──────────────────────────────────────────────────
    function renderProgress(reel: any) {
      setRail('video', ['char', 'idea', 'text', 'image']);
      showOnly(['block-video']);
      $('render-progress').hidden = false; $('done').hidden = true; $('fail').hidden = true;
      $('render-label').textContent = reel.status === 'audio_generating'
        ? 'Înregistrăm vocea…'
        : reel.status === 'assembling'
          ? 'Montaj final: lipim scenele și punem vocea…'
          : 'Animăm scenele…';
      const dots = $('render-dots');
      dots.innerHTML = '';
      (reel.storyboard?.scenes ?? []).forEach((s: any) => {
        const d = document.createElement('span');
        d.className = 'g-dot' + (s.video?.status === 'ready' ? ' done' : s.video?.status === 'generating' ? ' on' : '');
        dots.appendChild(d);
      });
    }
    function renderDone(reel: any) {
      setRail('', ['char', 'idea', 'text', 'image', 'video']);
      showOnly(['block-video']);
      $('render-progress').hidden = true; $('fail').hidden = true; $('done').hidden = false;
      ($('final-video') as HTMLVideoElement).src = reel.video_url;
      ($('btn-download') as HTMLAnchorElement).href = reel.video_url;
    }
    function renderFail(reel: any) {
      showOnly(['block-video']);
      $('render-progress').hidden = true; $('done').hidden = true; $('fail').hidden = false;
      $('fail-msg').textContent = reel.error_message ?? 'A apărut o eroare.';
      ($('btn-retry') as HTMLButtonElement).dataset.kind = reel.status === 'image_failed' ? 'image' : 'video';
    }
    $('btn-retry').addEventListener('click', async () => {
      const kind = ($('btn-retry') as HTMLButtonElement).dataset.kind;
      await api(`/api/studio/reels/${reelId}/generate-${kind}`, { method: 'POST', body: '{}' }).catch(() => {});
      poll();
    });
    $('btn-new').addEventListener('click', () => { window.location.href = '/dashboard'; });

    // ── poll loop ────────────────────────────────────────────────────────────
    async function poll() {
      if (!reelId) return;
      if (pollTimer) clearTimeout(pollTimer);
      try {
        const { reel } = await api(`/api/studio/reels/${reelId}`);
        board = reel.storyboard ?? board;
        switch (reel.status) {
          case 'storyboard_ready':
            // resumed reel: text already approved → jump to images
            if (reel.text_approved_at) renderImageChoice(); else renderText();
            return;
          case 'image_generating': renderImageChoice(); break;
          case 'image_ready': case 'image_failed': renderImageChoice(); return;
          case 'approved': case 'audio_generating': case 'video_generating': case 'assembling': renderProgress(reel); break;
          case 'complete': renderDone(reel); return;
          case 'video_failed': renderFail(reel); return;
          default: return;
        }
      } catch {}
      pollTimer = setTimeout(poll, 2500);
    }

    // deep-link resume
    const resumeId = new URLSearchParams(window.location.search).get('reel');
    if (resumeId) { reelId = resumeId; showOnly([]); poll(); }
  </script>
</body>
</html>
